generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RdoStatus {
  DRAFT
  SENT_TO_TECHNICAL_ROOM
  IN_VALIDATION
  APPROVED
  REJECTED
}

enum OccurrenceSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CANCELED
}

enum SyncEventStatus {
  ACCEPTED
  CONFLICT
  REJECTED
}

model Project {
  id             String            @id @default(uuid())
  name           String
  customerName   String?
  contractNumber String?
  startedAt      DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  segments       RoadSegment[]
  workFronts     WorkFront[]
  rdos           Rdo[]
  weather        WeatherSnapshot[]
}

model RoadSegment {
  id               String            @id @default(uuid())
  projectId        String
  startKm          Decimal           @db.Decimal(10, 3)
  endKm            Decimal           @db.Decimal(10, 3)
  description      String?
  project          Project           @relation(fields: [projectId], references: [id])
  workFronts       WorkFront[]
  weatherSnapshots WeatherSnapshot[]

  @@index([projectId])
}

model WorkFront {
  id          String       @id @default(uuid())
  projectId   String
  segmentId   String?
  name        String
  responsible String?
  active      Boolean      @default(true)
  project     Project      @relation(fields: [projectId], references: [id])
  segment     RoadSegment? @relation(fields: [segmentId], references: [id])
  rdos        Rdo[]

  @@index([projectId])
  @@index([segmentId])
}

model Rdo {
  id                String             @id @default(uuid())
  projectId         String
  workFrontId       String?
  deviceId          String?
  reportDate        DateTime
  status            RdoStatus          @default(DRAFT)
  createdByName     String
  approvedByName    String?
  notes             String?
  submittedAt       DateTime?
  approvedAt        DateTime?
  clientUpdatedAt   DateTime?
  serverVersion     Int                @default(1)
  isDeleted         Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  project           Project            @relation(fields: [projectId], references: [id])
  workFront         WorkFront?         @relation(fields: [workFrontId], references: [id])
  laborEntries      LaborEntry[]
  equipmentEntries  EquipmentEntry[]
  productionEntries ProductionEntry[]
  occurrences       Occurrence[]
  weatherSnapshots  WeatherSnapshot[]

  @@index([projectId, reportDate])
  @@index([workFrontId])
  @@index([status])
}

model LaborEntry {
  id       String  @id @default(uuid())
  rdoId    String
  role     String
  quantity Int
  hours    Decimal @db.Decimal(8, 2)
  rdo      Rdo     @relation(fields: [rdoId], references: [id])

  @@index([rdoId])
}

model EquipmentEntry {
  id                   String               @id @default(uuid())
  rdoId                String
  equipmentCode        String
  description          String?
  startedAt            DateTime?
  stoppedAt            DateTime?
  downtimeMinutes      Int?
  broken               Boolean              @default(false)
  maintenanceRequested Boolean              @default(false)
  rdo                  Rdo                  @relation(fields: [rdoId], references: [id])
  maintenanceRequests  MaintenanceRequest[]

  @@index([rdoId])
  @@index([equipmentCode])
}

model ProductionEntry {
  id          String  @id @default(uuid())
  rdoId       String
  serviceCode String?
  description String
  unit        String
  quantity    Decimal @db.Decimal(12, 3)
  startKm     Decimal? @db.Decimal(10, 3)
  endKm       Decimal? @db.Decimal(10, 3)
  rdo         Rdo     @relation(fields: [rdoId], references: [id])

  @@index([rdoId])
}

model Occurrence {
  id             String             @id @default(uuid())
  rdoId          String
  type           String
  description    String
  severity       OccurrenceSeverity @default(LOW)
  actionRequired Boolean            @default(false)
  assignedTo     String?
  createdAt      DateTime           @default(now())
  rdo            Rdo                @relation(fields: [rdoId], references: [id])

  @@index([rdoId])
  @@index([severity])
}

model WeatherSnapshot {
  id                  String    @id @default(uuid())
  projectId           String
  segmentId           String?
  rdoId               String?
  source              String
  collectedAt         DateTime
  forecastFor         DateTime?
  temperatureC        Decimal?  @db.Decimal(5, 2)
  rainfallProbability Int?
  rainfallMm          Decimal?  @db.Decimal(8, 2)
  windKmh             Decimal?  @db.Decimal(8, 2)
  humidity            Int?
  project             Project   @relation(fields: [projectId], references: [id])
  segment             RoadSegment? @relation(fields: [segmentId], references: [id])
  rdo                 Rdo?      @relation(fields: [rdoId], references: [id])

  @@index([projectId, collectedAt])
  @@index([segmentId])
  @@index([rdoId])
}

model MaintenanceRequest {
  id               String            @id @default(uuid())
  equipmentEntryId String?
  rdoId            String?
  equipmentCode    String
  reportedByName   String
  problemDescription String
  priority         OccurrenceSeverity @default(MEDIUM)
  status           MaintenanceStatus  @default(OPEN)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  equipmentEntry   EquipmentEntry?    @relation(fields: [equipmentEntryId], references: [id])

  @@index([equipmentCode])
  @@index([status])
}

model SyncEvent {
  id             String          @id @default(uuid())
  deviceId       String
  entityName     String
  entityId       String
  operation      String
  payload        Json
  occurredAt     DateTime
  receivedAt     DateTime        @default(now())
  status         SyncEventStatus @default(ACCEPTED)
  conflictReason String?

  @@index([deviceId, receivedAt])
  @@index([entityName, entityId])
}

model AuditLog {
  id         String   @id @default(uuid())
  entityName String
  entityId   String
  action     String
  actorName  String?
  occurredAt DateTime @default(now())
  metadata   Json?

  @@index([entityName, entityId])
}
