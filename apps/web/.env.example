# Cortex 3 uses the PostgreSQL e-mail access boundary in development and
# production. Legacy mode is available only to explicitly maintained builds.
VITE_CORTEX_AUTH_MODE=postgresql
VITE_CORTEX_API_BASE_URL=/api

# Mapa da rodovia. O padrão é MapLibre com a malha vetorial aberta do
# OpenFreeMap e o Leaflet sobre OpenStreetMap: nenhum dos dois exige chave.
# MapTiler e Mapbox são opcionais e só entram se a credencial existir.
VITE_MAP_PROVIDER=maplibre
VITE_MAPLIBRE_STYLE_URL=
VITE_MAPTILER_API_KEY=
VITE_MAPBOX_ACCESS_TOKEN=

# Enquadramento inicial do mapa quando a obra ainda não tem coordenada. O
# resultado nunca é gravado nem vira geometria: serve só para abrir a tela na
# região do cadastro. Vazio usa o Nominatim público do OpenStreetMap.
VITE_GEOCODER_URL=
