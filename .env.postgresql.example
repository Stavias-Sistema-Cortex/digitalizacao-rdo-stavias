# PostgreSQL clean-start operator environment for Córtex.
# Copy only non-secret values into an untracked local file. Every *_FILE value
# is a path to a local secret file; do not place secret values in this file.
# MySQL remains read-only source integration for Academy/Zeladoria only.

CORTEX_POSTGRES_USER=<POSTGRES_ROLE>
CORTEX_POSTGRES_URL=jdbc:postgresql://127.0.0.1:5432/StaviasCortex
# Keep blank only when an explicitly trusted local PostgreSQL policy accepts
# passwordless connections. Production must use a protected file path.
CORTEX_POSTGRES_PASSWORD_FILE=<ABSOLUTE_PATH_TO_POSTGRES_PASSWORD_FILE>

# Fail closed by default. Set this to true only after V60, the real ALFA
# bootstrap, mounted secrets, storage/SMTP checks, and the runtime release
# preflight have all succeeded.
CORTEX_POSTGRES_RUNTIME_READY=false

# Bootstrap uses only this protected file path and an Academy SELECT-only
# source. The bootstrap script reads no protected identifier from this file.
CORTEX_BOOTSTRAP_ADMIN_CPF_FILE=<ABSOLUTE_PATH_TO_OWNER_SECRET_FILE>
CORTEX_AUTH_CPF_HMAC_CURRENT_KEY_ID=<CURRENT_HMAC_KEY_ID>
CORTEX_AUTH_CPF_HMAC_CURRENT_KEY_FILE=<ABSOLUTE_PATH_TO_CPF_HMAC_KEY_FILE>
CORTEX_AUTH_OFFLINE_GRANT_KEY_ID=<CURRENT_OFFLINE_GRANT_KEY_ID>
CORTEX_AUTH_OFFLINE_GRANT_PRIVATE_KEY_FILE=<ABSOLUTE_PATH_TO_OFFLINE_GRANT_PRIVATE_KEY_FILE>
CORTEX_AUTH_OFFLINE_GRANT_PUBLIC_KEY_FILE=<ABSOLUTE_PATH_TO_OFFLINE_GRANT_PUBLIC_KEY_FILE>
CORTEX_MEMORY_CURSOR_HMAC_CURRENT_KEY_ID=<CURRENT_MEMORY_CURSOR_HMAC_KEY_ID>
CORTEX_MEMORY_CURSOR_HMAC_CURRENT_KEY_FILE=<ABSOLUTE_PATH_TO_MEMORY_CURSOR_HMAC_KEY_FILE>

# O login online normal usa CPF somente para localizar a identidade Academy
# canônica já espelhada no PostgreSQL e emite uma sessão opaca. A passkey é uma
# alternativa online. Offline, o grant colaborativo exige o mesmo CPF e o cofre
# PRF exige uma passkey previamente registrada; nenhum dos dois autoriza a API.
# Estes valores cruzam o build web e devem corresponder à chave pública publicada
# pela API.
VITE_CORTEX_AUTH_MODE=postgresql
VITE_CORTEX_API_BASE_URL=/api
VITE_CORTEX_OFFLINE_GRANT_PUBLIC_KEY_SHA256=<BASE64URL_SHA256_OF_OFFLINE_PUBLIC_KEY_DER>

# The web container is loopback-only by default. Publish it through the managed
# TLS ingress, or explicitly set a different trusted ingress bind address.
# The public origin must be one exact HTTPS origin with no wildcard, path,
# query, or credentials.
CORTEX_WEB_BIND_ADDRESS=127.0.0.1
CORTEX_WEB_PORT=8080
CORTEX_PUBLIC_ORIGIN=https://cortex.example.invalid
CORTEX_AUTH_WEBAUTHN_RP_ID=cortex.example.invalid
CORTEX_AUTH_WEBAUTHN_RP_NAME=Córtex

# SMTP nunca autentica o usuário. Ele permanece no runtime normal apenas para
# entregas operacionais idempotentes, como o scheduler financeiro. Em produção,
# use STARTTLS e senha exclusivamente em arquivo secreto.
CORTEX_EMAIL_PROVIDER=smtp
CORTEX_EMAIL_SENDER_PROFILE_KEY=<AUTHENTICATED_SENDER_PROFILE_KEY>
CORTEX_SMTP_HOST=<SMTP_HOST>
CORTEX_SMTP_PORT=587
CORTEX_SMTP_USERNAME=<SMTP_USERNAME>
CORTEX_SMTP_FROM=<SMTP_FROM_ADDRESS>
CORTEX_SMTP_PASSWORD_FILE=<ABSOLUTE_PATH_TO_SMTP_PASSWORD_FILE>
CORTEX_SMTP_STARTTLS=true

# Read-only Academy/Zeladoria sources are integration inputs only. Do not use
# them as the Córtex canonical datasource and do not place passwords here.
CORTEX_ACADEMY_DB_URL=<ACADEMY_READ_ONLY_JDBC_URL>
CORTEX_ACADEMY_DB_USER=<ACADEMY_READ_ONLY_USERNAME>
CORTEX_ACADEMY_DB_PASSWORD_FILE=<ABSOLUTE_PATH_TO_ACADEMY_PASSWORD_FILE>
CORTEX_ZELADORIA_DB_URL=<ZELADORIA_READ_ONLY_JDBC_URL>
CORTEX_ZELADORIA_DB_USER=<ZELADORIA_READ_ONLY_USERNAME>
CORTEX_ZELADORIA_DB_PASSWORD_FILE=<ABSOLUTE_PATH_TO_ZELADORIA_PASSWORD_FILE>

# This controls scheduled pulls from the two source systems above. It is
# intentionally separate from the PWA outbox, which retries local mutations
# automatically when connectivity returns. Keep source pulls false until their
# SELECT-only roles and first production sync have been verified.
CORTEX_SYNC_ENABLED=false

# Never commit secret file contents, an owner bootstrap secret, or Academy /
# Zeladoria credentials. PostgreSQL holds Córtex records; object bytes use the
# approved object store and PostgreSQL stores only keys and metadata.
