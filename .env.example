# Copy to .env only for local development. Production secrets belong in the
# platform secret manager or mounted *_FILE paths and must never be committed.

# Canonical PostgreSQL database. The Docker URL must reach the same
# canonical database instance as the host URL. Keep the password only in the
# protected file referenced below.
CORTEX_POSTGRES_URL=jdbc:postgresql://127.0.0.1:5432/StaviasCortex
CORTEX_POSTGRES_DOCKER_URL=jdbc:postgresql://host.docker.internal:5432/StaviasCortex
CORTEX_POSTGRES_USER=cortex_app
CORTEX_POSTGRES_PASSWORD_FILE=
CORTEX_POSTGRES_RUNTIME_READY=false

# Runtime and exact same-origin web configuration
SPRING_PROFILES_ACTIVE=local,postgresql
CORTEX_CORS_ALLOWED_ORIGINS=http://localhost:5173
CORTEX_AUTH_COOKIE_SECURE=false
CORTEX_AUTH_COOKIE_SAME_SITE=Lax
CORTEX_AUTH_SESSION_TTL_SECONDS=43200
VITE_CORTEX_AUTH_MODE=postgresql
VITE_CORTEX_API_BASE_URL=/api

# CPF lookup HMAC. Production requires current-key-file and rejects inline keys.
CORTEX_AUTH_CPF_HMAC_CURRENT_KEY_ID=local-v1
CORTEX_AUTH_CPF_HMAC_CURRENT_KEY_FILE=
CORTEX_AUTH_CPF_HMAC_PREVIOUS_KEY_ID=
CORTEX_AUTH_CPF_HMAC_PREVIOUS_KEY_FILE=

# OTP. Production requires hmac-key-file and rejects the inline value.
CORTEX_AUTH_OTP_HMAC_KEY_FILE=
CORTEX_AUTH_OTP_TTL_SECONDS=600
CORTEX_AUTH_OTP_MAX_ATTEMPTS=5
CORTEX_AUTH_OTP_RATE_LIMIT_MAX_REQUESTS=5
CORTEX_AUTH_OTP_RATE_LIMIT_GLOBAL_MAX_REQUESTS=100
CORTEX_AUTH_OTP_RATE_LIMIT_WINDOW_SECONDS=900

# Passkeys / WebAuthn. Production values must be exact HTTPS origins and the
# RP ID must be the public hostname without scheme or port.
# Recomendado para desenvolvimento local: localhost.
CORTEX_AUTH_WEBAUTHN_RP_ID=localhost
CORTEX_AUTH_WEBAUTHN_RP_NAME=Córtex Local
CORTEX_AUTH_WEBAUTHN_ALLOWED_ORIGINS=http://localhost:5173
CORTEX_AUTH_WEBAUTHN_CHALLENGE_TTL_SECONDS=300
CORTEX_AUTH_WEBAUTHN_RATE_LIMIT_MAX_REQUESTS=20
CORTEX_AUTH_WEBAUTHN_GLOBAL_RATE_LIMIT_MAX_REQUESTS=2000
CORTEX_AUTH_WEBAUTHN_RATE_LIMIT_WINDOW_SECONDS=900
CORTEX_AUTH_WEBAUTHN_MAX_REQUEST_BODY_BYTES=65536

# Offline grant signing. Production requires mounted PKCS#8 private and X.509
# SubjectPublicKeyInfo public PEM files. Build the web fingerprint from the
# public key and pass it as a Vite build argument.
CORTEX_AUTH_OFFLINE_GRANT_KEY_ID=
CORTEX_AUTH_OFFLINE_GRANT_PRIVATE_KEY_FILE=
CORTEX_AUTH_OFFLINE_GRANT_PUBLIC_KEY_FILE=
CORTEX_AUTH_OFFLINE_GRANT_TTL_SECONDS=86400
CORTEX_AUTH_OFFLINE_GRANT_MAX_WORKSITES=500
CORTEX_MEMORY_CURSOR_HMAC_CURRENT_KEY_ID=
CORTEX_MEMORY_CURSOR_HMAC_CURRENT_KEY_FILE=
CORTEX_MEMORY_CURSOR_HMAC_PREVIOUS_KEY_ID=
CORTEX_MEMORY_CURSOR_HMAC_PREVIOUS_KEY_FILE=
VITE_CORTEX_OFFLINE_GRANT_PUBLIC_KEY_SHA256=

# One-shot identity provisioning (non-web process only).
CORTEX_AUTH_PROVISIONING_ENABLED=false
CORTEX_AUTH_PROVISIONING_FILE=
CORTEX_AUTH_DEV_ADMIN_ENABLED=false
CORTEX_AUTH_TRUSTED_PROXY_CIDRS=

# E-mail. Local uses fake; production requires smtp, STARTTLS and a mounted
# password file. From is provider configuration, never client input.
CORTEX_EMAIL_PROVIDER=fake
CORTEX_EMAIL_SENDER_PROFILE_KEY=
CORTEX_SMTP_FROM=
CORTEX_SMTP_HOST=
CORTEX_SMTP_PORT=587
CORTEX_SMTP_USERNAME=
CORTEX_SMTP_PASSWORD_FILE=
CORTEX_SMTP_STARTTLS=true
CORTEX_SMTP_CONNECT_TIMEOUT_MS=5000
CORTEX_SMTP_READ_TIMEOUT_MS=5000
CORTEX_SMTP_WRITE_TIMEOUT_MS=5000

# Durable object storage. Production accepts either persistent local storage or
# a private S3-compatible bucket. AWS credentials use the standard SDK chain.
CORTEX_STORAGE_PROVIDER=local
CORTEX_STORAGE_MAX_SIZE_BYTES=26214400
CORTEX_STORAGE_ALLOWED_MEDIA_TYPES=application/pdf,application/zip,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation,image/png,image/jpeg,image/gif,image/webp,text/plain,text/csv
CORTEX_STORAGE_LOCAL_ROOT=/var/lib/cortex/objects
CORTEX_STORAGE_LOCAL_PERSISTENT=true
CORTEX_STORAGE_S3_BUCKET=
CORTEX_STORAGE_S3_REGION=
CORTEX_STORAGE_S3_ENDPOINT=
CORTEX_STORAGE_S3_PREFIX=
CORTEX_STORAGE_S3_PATH_STYLE=false
VITE_CORTEX_MESSAGE_MAX_ATTACHMENT_BYTES=26214400

# Idempotent financial charge delivery
CORTEX_FINANCE_EMAIL_SCHEDULER_ENABLED=false
CORTEX_FINANCE_EMAIL_SCHEDULER_BATCH_SIZE=25
CORTEX_FINANCE_EMAIL_SCHEDULER_INITIAL_DELAY_MS=30000
CORTEX_FINANCE_EMAIL_SCHEDULER_FIXED_DELAY_MS=60000
CORTEX_FINANCE_EMAIL_RETRY_MAX_ATTEMPTS=4
CORTEX_FINANCE_EMAIL_RETRY_INITIAL_DELAY_SECONDS=120
CORTEX_FINANCE_EMAIL_RETRY_MAX_DELAY_SECONDS=3600
CORTEX_FINANCE_EMAIL_DISPATCH_LEASE_SECONDS=120

# Import and background sync are opt-in. Production must keep dev admin off.
CORTEX_IMPORT_ENABLED=false
CORTEX_SYNC_ENABLED=true
CORTEX_SYNC_INITIAL_DELAY_MS=60000
CORTEX_SYNC_FIXED_DELAY_MS=300000

# Optional external sources
CORTEX_ZELADORIA_DB_URL=
CORTEX_ZELADORIA_DB_USER=
CORTEX_ZELADORIA_DB_PASSWORD=
CORTEX_ACADEMY_DB_URL=
CORTEX_ACADEMY_DB_USER=
CORTEX_ACADEMY_DB_PASSWORD=
