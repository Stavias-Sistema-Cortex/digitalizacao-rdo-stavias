# Local Córtex database
CORTEX_DB_URL=jdbc:mysql://127.0.0.1:3306/cortex_dev?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
CORTEX_DB_USER=cortex_app
CORTEX_DB_PASSWORD=
CORTEX_MYSQL_ROOT_PASSWORD=
# Stable local-only CPF lookup key. Generate your own; never commit .env.
CORTEX_AUTH_CPF_HMAC_CURRENT_KEY_ID=local-v1
CORTEX_AUTH_CPF_HMAC_CURRENT_KEY=

# WebAuthn relying party. Production startup fails closed when these are empty.
# RP ID is the deploy hostname without scheme or port. Origins are comma-separated.
CORTEX_AUTH_WEBAUTHN_RP_ID=
CORTEX_AUTH_WEBAUTHN_RP_NAME=Córtex
CORTEX_AUTH_WEBAUTHN_ALLOWED_ORIGINS=
CORTEX_AUTH_WEBAUTHN_CHALLENGE_TTL_SECONDS=300
# Public passkey endpoints use shared database-backed rate limits.
CORTEX_AUTH_WEBAUTHN_RATE_LIMIT_MAX_REQUESTS=20
CORTEX_AUTH_WEBAUTHN_GLOBAL_RATE_LIMIT_MAX_REQUESTS=2000
CORTEX_AUTH_WEBAUTHN_RATE_LIMIT_WINDOW_SECONDS=900
CORTEX_AUTH_WEBAUTHN_MAX_REQUEST_BODY_BYTES=65536

# Production-only offline grant signer. Mount PKCS#8 private and X.509 public
# PEM files; local/test profiles generate an ephemeral pair automatically.
CORTEX_AUTH_OFFLINE_GRANT_KEY_ID=
CORTEX_AUTH_OFFLINE_GRANT_PRIVATE_KEY_FILE=
CORTEX_AUTH_OFFLINE_GRANT_PUBLIC_KEY_FILE=
CORTEX_AUTH_OFFLINE_GRANT_TTL_SECONDS=86400
CORTEX_AUTH_OFFLINE_GRANT_MAX_WORKSITES=500
# Build-time SHA-256 fingerprint(s), base64url without padding, of the same
# DER SubjectPublicKeyInfo mounted above. Separate rotations with commas.
VITE_CORTEX_OFFLINE_GRANT_PUBLIC_KEY_SHA256=

# External Stavias ZLD source
ZLD_DB_URL=
ZLD_DB_USER=
ZLD_DB_PASSWORD=

# External Stavias Academy source
ACAD_DB_URL=
ACAD_DB_USER=
ACAD_DB_PASSWORD=

# Optional local LLM API key. Keep empty for unauthenticated local Ollama.
CORTEX_STAVIA_LLM_API_KEY=

# Import protection
CORTEX_IMPORT_ENABLED=false
