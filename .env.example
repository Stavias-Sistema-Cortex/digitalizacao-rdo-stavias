# Local Córtex database
CORTEX_DB_URL=jdbc:mysql://127.0.0.1:3306/cortex_dev?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
CORTEX_DB_USER=cortex_app
CORTEX_DB_PASSWORD=
CORTEX_MYSQL_ROOT_PASSWORD=
CORTEX_AUTH_JWT_SECRET=

# Protected message attachments (server-side, never a public URL)
CORTEX_ATTACHMENT_STORAGE_PATH=./var/cortex-attachments
CORTEX_ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760
CORTEX_ATTACHMENT_MAX_MESSAGE_SIZE_BYTES=26214400

# External Stavias ZLD source
ZLD_DB_URL=
ZLD_DB_USER=
ZLD_DB_PASSWORD=

# External Stavias Academy source
ACAD_DB_URL=
ACAD_DB_USER=
ACAD_DB_PASSWORD=

# Optional local LLM API key. Keep empty for unauthenticated local Ollama.
CORTEX_STAVIA_LLM_API_KEY=

# Import protection
CORTEX_IMPORT_ENABLED=false
