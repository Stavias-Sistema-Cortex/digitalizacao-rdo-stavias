# Local Córtex database
CORTEX_DB_URL=jdbc:mysql://127.0.0.1:3306/cortex_dev?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
CORTEX_DB_USER=cortex_app
CORTEX_DB_PASSWORD=
CORTEX_MYSQL_ROOT_PASSWORD=
CORTEX_AUTH_JWT_SECRET=
# Produção: proteção contra tentativa repetida no login por CPF.
# O perfil local já desativa este limite por padrão.
CORTEX_AUTH_LOGIN_RATE_LIMIT_ENABLED=true
CORTEX_AUTH_LOGIN_RATE_LIMIT_ATTEMPTS_PER_MINUTE=20
CORTEX_AUTH_LOGIN_RATE_LIMIT_GLOBAL_ATTEMPTS_PER_MINUTE=1000

# Protected message attachments (server-side, never a public URL)
CORTEX_ATTACHMENT_STORAGE_PATH=./var/cortex-attachments
CORTEX_ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760
CORTEX_ATTACHMENT_MAX_MESSAGE_SIZE_BYTES=26214400
CORTEX_ATTACHMENT_MULTIPART_MAX_FILE_SIZE=11MB
CORTEX_ATTACHMENT_MULTIPART_MAX_REQUEST_SIZE=12MB
CORTEX_ATTACHMENT_RATE_LIMIT_UPLOADS_PER_MINUTE=20
CORTEX_ATTACHMENT_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,text/plain,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# External Stavias ZLD source
ZLD_DB_URL=
ZLD_DB_USER=
ZLD_DB_PASSWORD=

# External Stavias Academy source
ACAD_DB_URL=
ACAD_DB_USER=
ACAD_DB_PASSWORD=

# Optional local LLM API key. Keep empty for unauthenticated local Ollama.
CORTEX_STAVIA_LLM_API_KEY=

# Import protection
CORTEX_IMPORT_ENABLED=false

# Variáveis públicas do frontend (use apenas chaves/tokens públicos de mapas).
VITE_MAP_PROVIDER=maptiler
VITE_MAPTILER_API_KEY=
# VITE_MAPBOX_ACCESS_TOKEN=
